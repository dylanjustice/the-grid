# artifact-credentials.yaml.example
#
# Copy this file to artifact-credentials.yaml (or any name you prefer),
# fill in real base64-encoded values, and apply it to the cluster BEFORE
# enabling artifact storage on a SyntheticTest:
#
#   kubectl apply -n the-grid-synthetics -f artifact-credentials.yaml
#
# Then set spec.artifactStorage.credentialsSecret to match this Secret's name.
#
# To encode a value:  echo -n "your-value" | base64
#
# DO NOT commit artifact-credentials.yaml with real credentials.
# Add it to .gitignore if you create it locally.
apiVersion: v1
kind: Secret
metadata:
  name: artifact-credentials
  namespace: the-grid-synthetics
type: Opaque
data:
  # base64-encoded S3 / MinIO access key ID
  accessKey: <base64-encoded-access-key-id>
  # base64-encoded S3 / MinIO secret access key
  secretKey: <base64-encoded-secret-access-key>
